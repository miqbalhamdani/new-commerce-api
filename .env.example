# P1-000 runs against PostgreSQL 18 and Redis 8 installed on the host, not in
# containers. See contracts/tdd.md 2.2. These values are also the compiled-in
# defaults, so a .env is only needed to deviate from them.
#
#   brew services start postgresql@18 redis
#   make db-create

# The schema owner. cmd/migrate only -- locally this is a superuser, which
# bypasses row level security entirely.
DATABASE_URL=postgres://localhost:5432/new_commerce_dev?sslmode=disable

# app_user, which owns nothing. cmd/api serves every request on this one.
APP_DATABASE_URL=postgres://app_user@localhost:5432/new_commerce_dev?sslmode=disable
REDIS_URL=redis://localhost:6379/0
PORT=8080

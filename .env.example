# P1-000 runs against PostgreSQL 18 and Redis 8 installed on the host, not in
# containers (05-backlog.md Phase 0, P1-000). These values are also the compiled-in
# defaults, so a .env is only needed to deviate from them.
#
#   brew services start postgresql@18 redis
#   make db-create

# The schema owner. cmd/migrate only -- locally this is a superuser, which
# bypasses row level security entirely.
DATABASE_URL=postgres://localhost:5432/new_commerce_dev?sslmode=disable

# app_user, which owns nothing. cmd/api serves every request on this one.
APP_DATABASE_URL=postgres://app_user@localhost:5432/new_commerce_dev?sslmode=disable
REDIS_URL=redis://localhost:6379/0
PORT=8080

# Object storage (BR-053): R2 in production, MinIO locally. The defaults are
# MinIO's; `brew services start minio && make storage-init` creates the bucket.
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=new-commerce-dev
S3_USE_SSL=false
IMAGE_BASE_URL=http://localhost:9000/new-commerce-dev

# Email (BR-128). Without RESEND_API_KEY, development sends to SMTP_ADDR --
# Mailpit (`brew services start mailpit`, inbox at http://localhost:8025) --
# or, with SMTP_ADDR empty, prints mail to stdout. Elsewhere the worker refuses
# to start without a key. EMAIL_DOMAIN is what no-reply@ is sent from (P1-225).
# Links in mail point at ADMIN_URL.
RESEND_API_KEY=
SMTP_ADDR=localhost:1025
EMAIL_DOMAIN=example.com
ADMIN_URL=http://localhost:3000
# Signs invitation tokens (BR-026). Required outside development.
INVITE_SECRET=

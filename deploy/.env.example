# Copy to deploy/.env on the box and `chmod 600` it. Compose refuses to start
# while a required value is empty. Generate each secret on the box:
#   openssl rand -hex 32        (passwords and signing secrets)
#   openssl rand -base64 32     (ENCRYPTION_KEY: exactly 32 bytes)

# Hosts and TLS (04-api-spec.md §1, P1-001)
ADMIN_HOST=admin.example.com
API_HOST=api.example.com
# The Cloudflare Origin certificate, in deploy/certs/ (05-backlog.md, P1-001).
TLS=/certs/origin.pem /certs/origin.key
# Cloudflare's ranges, https://www.cloudflare.com/ips/ -- only they may set
# CF-Connecting-IP. Re-check them when Cloudflare announces a change.
CADDY_TRUSTED_PROXIES=173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

# Database: the schema owner runs migrations; the app connects as app_user.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# App secrets (BR-022, BR-091, BR-094, BR-129). Rotating one: the runbook.
JWT_SECRET=
INVITE_SECRET=
ORDER_TOKEN_SECRET=
PASSWORD_RESET_SECRET=
ENCRYPTION_KEY=

# Providers (05-backlog.md, Phase 3 cutover notes)
BITESHIP_API_KEY=
# Staff Google sign-in (BR-020): a Web client allowing https://admin.{domain}. Empty = off.
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
EMAIL_DOMAIN=example.com

# R2 (05-backlog.md, P1-045)
S3_ENDPOINT=<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_USE_SSL=true
IMAGE_BASE_URL=https://img.example.com

# Traces (P1-501); empty sends none.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- A provider-managed PostgreSQL (README.md, "Managed database") ---
# COMPOSE_FILE=compose.yaml:compose.managed-db.yaml:compose.small.yaml
# The provider's direct port (not a transaction pooler), TLS on. Migrate runs
# as the admin role, which owns the schema; the app as app_user, whose
# password is APP_DB_PASSWORD above. POSTGRES_PASSWORD is then unused but must
# be set.
# MIGRATE_DATABASE_URL=postgres://<admin>:<password>@<host>:<port>/new_commerce?sslmode=require
# APP_DATABASE_URL=postgres://app_user:<APP_DB_PASSWORD>@<host>:<port>/new_commerce?sslmode=require
#
# A provider whose admin role can create neither app_user nor a BYPASSRLS role
# (a shared plan) takes DB_ROLE_MODE=limited (BR-001): APP_DATABASE_URL is
# then the admin URL too. The first migrate fixes the mode; run
# db-preflight.sh before it. sslmode=disable only where the provider offers
# no TLS at all -- every query and row then crosses the network in clear text.
# DB_ROLE_MODE=limited

# Backups of a managed database (backup.sh, P1-003): an R2 bucket and token of
# their own, so the app's S3 key cannot delete them. The passphrase goes in
# the vault -- without it every backup is unreadable.
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_BUCKET=
# BACKUP_PASSPHRASE=

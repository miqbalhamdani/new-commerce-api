# Settings for the stack on a developer machine (README.md). Throwaway values,
# committed on purpose: none of them is a secret anywhere but this laptop.
ADMIN_HOST=admin.localhost
API_HOST=api.localhost
# Shops at {slug}.localhost (BR-140).
ROOT_DOMAIN=localhost
STOREFRONT_PLATFORM_KEY=local-platform-key
TLS=internal
# k6 and curl reach Caddy from the Compose network or the host, and may say
# which shopper they are in CF-Connecting-IP, as Cloudflare would.
CADDY_TRUSTED_PROXIES=private_ranges

API_IMAGE=ghcr.io/miqbalhamdani/new-commerce-api:local
WEB_IMAGE=ghcr.io/miqbalhamdani/new-commerce-web:local
STOREFRONT_IMAGE=ghcr.io/miqbalhamdani/belli-storefront:local

POSTGRES_PASSWORD=local-postgres
APP_DB_PASSWORD=local-app-user

JWT_SECRET=local-jwt-secret-not-for-production
INVITE_SECRET=local-invite-secret
ORDER_TOKEN_SECRET=local-order-token-secret
PASSWORD_RESET_SECRET=local-password-reset-secret
ENCRYPTION_KEY=bG9jYWwtZW5jcnlwdGlvbi1rZXktMzItYnl0ZXMhISE=

BITESHIP_API_KEY=local
BITESHIP_URL=http://biteship
RESEND_API_KEY=re_local_mail_is_not_sent
EMAIL_DOMAIN=example.com

S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=new-commerce
S3_USE_SSL=false
IMAGE_BASE_URL=http://minio:9000/new-commerce
